POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise_user
POSTGRES_PASSWORD=enterprise_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=enterprise_neo4j_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=enterprise_knowledge

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Pinned HuggingFace commit for the embedding model. Verified: this revision
# re-encodes stored Qdrant vectors to cosine 1.0000000 (M0 task 2). Without a
# revision the weights can move under the collection and silently invalidate it.
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSION=384

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

OBSERVABILITY_DIR=reports/observability

# ----------------------------------------------------------------------------
# M6 security. Every value below is a PLACEHOLDER. Generate real ones with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# There are no working defaults in source: an unset secret fails loudly rather
# than silently connecting with a credential committed to the repository.
# ----------------------------------------------------------------------------

# Runtime PostgreSQL role: non-superuser, SELECT-only on the ecommerce schema.
# Created by database/create_readonly_role.sql. The loaders keep POSTGRES_USER,
# which owns the schema and legitimately writes.
POSTGRES_READONLY_USER=enterprise_readonly
POSTGRES_READONLY_PASSWORD=replace-with-a-generated-password

# Qdrant API key. Without it the collection accepts unauthenticated upserts --
# the audit poisoned the live collection and its text reached the answer prompt.
QDRANT_API_KEY=replace-with-a-generated-key
# Set true in any deployment where the key crosses a network you do not own.
QDRANT_HTTPS=false

# Bearer token required by POST /query.
API_BEARER_TOKEN=replace-with-a-generated-token
