POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise_user
POSTGRES_PASSWORD=enterprise_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=enterprise_neo4j_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=enterprise_knowledge

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Pinned HuggingFace commit for the embedding model. Verified: this revision
# re-encodes stored Qdrant vectors to cosine 1.0000000 (M0 task 2). Without a
# revision the weights can move under the collection and silently invalidate it.
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSION=384

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

OBSERVABILITY_DIR=reports/observability