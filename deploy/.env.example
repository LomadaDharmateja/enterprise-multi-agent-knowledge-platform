# Deployment environment (M8 Task 2). Copy to deploy/.env on the server.
#
# deploy/.env is git-ignored and .dockerignore'd. It is read by docker compose and
# mounted into the API via env_file -- it is never baked into an image layer.
#
# Every value below is a placeholder. Nothing here has a working default, by
# design: M6 removed the 17 hardcoded credential defaults that let the system come
# up with known passwords if the environment was incomplete.

# --- Public hostnames -------------------------------------------------------
# sslip.io resolves <anything>.<ip>.sslip.io to <ip>, so a bare VPS IP gets a real
# Let's Encrypt certificate with no domain and no DNS records. Replace the dashes
# form with your own domain when you have one.
APP_DOMAIN=REPLACE_WITH_SERVER_IP.sslip.io
API_DOMAIN=api.REPLACE_WITH_SERVER_IP.sslip.io
ACME_EMAIL=REPLACE_WITH_YOUR_EMAIL

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=enterprise_ai
POSTGRES_USER=REPLACE
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_SECRET
# M6: the query path connects as this SELECT-only role, not as the owner.
POSTGRES_READONLY_USER=REPLACE
POSTGRES_READONLY_PASSWORD=REPLACE_WITH_A_GENERATED_SECRET

# --- Neo4j ------------------------------------------------------------------
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_A_GENERATED_SECRET
NEO4J_HEAP=1G

# --- Qdrant -----------------------------------------------------------------
QDRANT_COLLECTION=enterprise_documents
QDRANT_API_KEY=REPLACE_WITH_A_GENERATED_SECRET
QDRANT_HTTPS=false

# --- Embedding model --------------------------------------------------------
# The revision is pinned because the stored vectors are only valid for these
# weights. The image bakes this exact revision in at build time.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSION=384

# --- Gemini -----------------------------------------------------------------
# Leave empty when DEMO_MODE=true: demo mode makes no LLM call, and an absent key
# is the strongest possible guarantee of that.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- API --------------------------------------------------------------------
API_BEARER_TOKEN=REPLACE_WITH_A_GENERATED_SECRET

# --- Demo mode (M8 Task 3) --------------------------------------------------
# true  -> replays recorded runs; no LLM call, no database query, no budget spent
# false -> live workflow
DEMO_MODE=true

# --- Observability ----------------------------------------------------------
# console keeps the memory store alongside, so GET /traces/{run_id} works with no
# collector. Set otlp and OTEL_EXPORTER_OTLP_ENDPOINT for retention.
OTEL_EXPORTER=console

# --- Images -----------------------------------------------------------------
API_IMAGE=enterprise-ai-api:latest
UI_IMAGE=enterprise-ai-ui:latest
